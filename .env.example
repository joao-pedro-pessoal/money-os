POSTGRES_PASSWORD="changeme"   # only used by docker-compose
DATABASE_URL="postgresql://moneyos:changeme@localhost:5432/moneyos"
APP_PASSWORD="choose-a-real-password"
APP_SECRET="a-long-random-string-used-to-sign-the-session-cookie"
COOKIE_SECURE="false"

# Required if you connect any platform that issues an API secret: Bybit,
# Trading 212, Kraken, Binance, OKX or MEXC. Hyperliquid and IBKR need none.
# A long random string — anything under 16 characters is refused. Keep it
# out of Git: whoever has this can decrypt the stored secrets.
ENCRYPTION_KEY=""

# Optional (V1.5). Shared secret for the schedulable sync endpoint
# POST /api/sync. Leave unset and that endpoint stays disabled — the
# "Sync now" button in the app works regardless.
SYNC_SECRET=""
SYNC_INTERVAL_SECONDS=900   # scheduled sync every 15 minutes (docker only)

# Optional (V3). Where IBKR's Client Portal Gateway is listening. The default
# suits running both on the same machine. In Docker the gateway is on the host,
# so use http://host.docker.internal:5000/v1/api instead.
# TLS verification is skipped only for loopback addresses, because the gateway
# ships a self-signed certificate — never for a remote host.
IBKR_GATEWAY_URL="https://localhost:5000/v1/api"

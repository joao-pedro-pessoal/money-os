<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The quick-entry notification, asked for only when it is switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- To put that notification back, and keep checking alerts, after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- singleTask: a widget or notification tap reaches the running app
             through onNewIntent instead of opening a second copy of the site. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".QuickEntryWidget"
            android:exported="false"
            android:label="Registo rápido">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_entry_widget" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$Dashboard"
            android:exported="false"
            android:label="Money OS">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$NetWorth"
            android:exported="false"
            android:label="Net worth">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_net_worth" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$WhereMoney"
            android:exported="false"
            android:label="Where the money is">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_where_money" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$CashFlow"
            android:exported="false"
            android:label="Cash flow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cash_flow" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$Investments"
            android:exported="false"
            android:label="Investments">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_investments" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$Allocation"
            android:exported="false"
            android:label="Allocation">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_allocation" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$Movers"
            android:exported="false"
            android:label="Winners &amp; losers">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_movers" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$Dividends"
            android:exported="false"
            android:label="Dividends">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dividends" />
        </receiver>

        <receiver
            android:name=".MoneyWidgets$OpenTrades"
            android:exported="false"
            android:label="Open trades">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_trades" />
        </receiver>

        <!-- The rows of the Investments widget. -->
        <service
            android:name=".PositionsListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- The half-hourly look at the site's alerts, when switched on. -->
        <service
            android:name=".Alerts$Check"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Quick settings tiles, beside the torch and Wi-Fi. -->
        <service
            android:name=".Tiles$RecordExpense"
            android:exported="true"
            android:icon="@drawable/ic_stat_quick_entry"
            android:label="Record expense"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".Tiles$NetWorth"
            android:exported="true"
            android:icon="@drawable/ic_stat_quick_entry"
            android:label="Net worth"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".QuickEntryRestore"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

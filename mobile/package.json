{
  "name": "money-os-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && node scripts/bundle-migrations.mjs",
    "export": "expo export --platform all",
    "test:connectors": "vitest run --config vitest.connectors.config.ts"
  },
  "dependencies": {
    "expo": "57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-dev-client": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-local-authentication": "~57.0.2",
    "expo-screen-capture": "~57.0.2",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-document-picker": "~57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "@noble/ciphers": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "buffer": "^6.0.3",
    "zod": "^4.4.3",
    "drizzle-orm": "^0.45.2",
    "papaparse": "^5.5.4",
    "expo-system-ui": "~57.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19",
    "vitest": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "@types/papaparse": "^5.5.2"
  }
}
